# Environment Configuration
# Copy this file to .env and adjust values as needed

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend Configuration  
FRONTEND_PORT=5173
# Set this to the backend URL for production
VITE_API_URL=http://localhost:8000

# Data Configuration
DATA_FILE_PATH=../data/gita.txt

# RAG Engine Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=50
DEFAULT_CONTEXT_LIMIT=3

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional Docker configuration
# Docker Compose works without this file. Copy it to .env only when overrides are needed.

PORT=8080
HOST_PORT=8080

# Optional Gemini/Vertex AI answer synthesis.
# Leave GEMINI_PROJECT_ID empty to use the extractive RAG fallback.
GEMINI_PROJECT_ID=
GEMINI_LOCATION=us-central1
GEMINI_MODEL_ID=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TEMPERATURE=0.5